{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "sync",
            "type": "shell",
            "command": "uv sync",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "isort",
            "type": "shell",
            "command": "uv run isort --check src",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "fmt",
            "type": "shell",
            "command": "uv run black --check src",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": "isort"
        },
        {
            "label": "mypy",
            "type": "shell",
            "command": "uv run python -m mypy src",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": "fmt"
        },
        {
            "label": "lint",
            "type": "shell",
            "command": "uv run python -m pylint src",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src"
                }
            },
            "dependsOn": "mypy",
        },
        {
            "label": "test",
            "type": "shell",
            "command": "uv run python -m unittest discover -s test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src"
                }
            },
            "dependsOn": "lint",
        }
    ]
}